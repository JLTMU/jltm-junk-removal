{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.jltmjunk.com"
        }
      ],
      "destination": "https://jltmjunk.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/:slug"
    }
  ]
}
